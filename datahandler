#include "game.h"
// Mindahin data dari txt ke array of Struct
void readScores(Player players[], int *count) {
    FILE *fp = fopen(FILE_NAME, "r");
    *count = 0;
    if (fp == NULL) return; 
    while (fscanf(fp, "%s %d", players[*count].name, &players[*count].score) != EOF) {
        (*count)++;
        if (*count >= MAX_PLAYER) break;
    }
    fclose(fp);
}

// Revisi biar input bisa lebih dari 1 kata (string)
void saveScore(char name[], int score) {
    for (int i = 0; name[i] != '\0'; i++) {
        if (name[i] == ' ') {
            name[i] = '_';
        }
    }

    FILE *fp = fopen(FILE_NAME, "a");
    
    if (fp == NULL) {
        printf("[ERROR] Gagal menyimpan data ke file!\n");
        return;
    }

    fprintf(fp, "%s %d\n", name, score);
    fclose(fp);
    printf(">> Data berhasil disimpan! (Player: %s)\n", name);
}

void swap(Player *a, Player *b) {
    Player temp = *a;
    *a = *b;
    *b = temp;
}
// Quick Sort untuk leaderboard
int partition(Player arr[], int low, int high) {
    int pivot = arr[high].score;
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (arr[j].score > pivot) { //descending
            i++;
            swap(&arr[i], &arr[j]);
        }
    }
    swap(&arr[i + 1], &arr[high]);
    return (i + 1);
}

void quickSort(Player arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}
//udah di sorting
void sortScores(Player players[], int count) {
    if (count > 1) {
        quickSort(players, 0, count - 1);
    }
}

// show leaderboardnya
void viewLeaderboard() {
    Player players[MAX_PLAYERS];
    int count = 0;

    clearScreen(); // clear screen, belum ada ya.
    printf("==================================\n");
    printf("       LEADERBOARD (TOP RANK)     \n");
    printf("==================================\n");
    
    readScores(players, &count);
    if (count == 0) {
        printf("   Belum ada data pemain.\n");
        printf("   Jadilah yang pertama!\n");
    } else {
        sortScores(players, count);
        printf("%-4s | %-20s | %-5s\n", "No", "Username", "Score");
        printf("----------------------------------\n");
        for (int i = 0; i < count; i++) {
            //  Top 10
            if (i >= 10) break; 
            printf("%-4d | %-20s | %-5d\n", i + 1, players[i].name, players[i].score);
        }
    }
    printf("==================================\n");
    pauseGame(); //butuh util Pause buat freeze di page ini.
}
