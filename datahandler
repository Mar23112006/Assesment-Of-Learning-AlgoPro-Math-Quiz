#include "game.h"
// Nambahin nama & skor baru ke baris plg bwh file
void saveScore(char name[], int score) {
    FILE *fp = fopen(FILE_NAME, "a");
    
    if (fp == NULL) {
        printf("[ERROR] Gagal membuka file database!\n");
        return;
    }
    
    fprintf(fp, "%s %d\n", name, score);
    
    fclose(fp);
    printf(">> Skor berhasil disimpan ke database!\n");
}

// Mindahin data dari txt ke array of Struct
void readScores(Player players[], int *count) {
    FILE *fp = fopen(FILE_NAME, "r");
    *count = 0;
    if (fp == NULL) return; 
    while (fscanf(fp, "%s %d", players[*count].name, &players[*count].score) != EOF) {
        (*count)++;
        if (*count >= MAX_PLAYERS) break;
    }
    fclose(fp);
}

void swap(Player *a, Player *b) {
    Player temp = *a;
    *a = *b;
    *b = temp;
}
// sorting score secara descending
void sortScores(Player players[], int count) {
    int i, j;
    Player temp;
    for (i = 0; i < count - 1; i++) {
        for (j = 0; j < count - i - 1; j++) {
            if (players[j].score < players[j+1].score) {
                swap(&players[j], &players[j+1]);
            }
        }
    }
}

// show leaderboardnya
void viewLeaderboard() {
    Player players[MAX_PLAYERS];
    int count = 0;

    clearScreen(); // clear screen, belum ada ya.
    printf("==================================\n");
    printf("       LEADERBOARD (TOP RANK)     \n");
    printf("==================================\n");
    
    readScores(players, &count);
    if (count == 0) {
        printf("   Belum ada data pemain.\n");
        printf("   Jadilah yang pertama!\n");
    } else {
        sortScores(players, count);
        printf("%-4s | %-20s | %-5s\n", "No", "Username", "Score");
        printf("----------------------------------\n");
        for (int i = 0; i < count; i++) {
            //  Top 10
            if (i >= 10) break; 
            printf("%-4d | %-20s | %-5d\n", i + 1, players[i].name, players[i].score);
        }
    }
    printf("==================================\n");
    pauseGame(); //butuh util Pause buat freeze di page ini.
}
